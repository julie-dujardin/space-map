# Copy to .env (next to docker-compose.yaml) and fill in.
# .env is gitignored by the repo root.

# Long random string. Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=changeme

# Public hostname for the search service (the Cloudflare tunnel route and the
# indexer's MEILI_URL). TLS is terminated by Cloudflare, not Caddy, so this is
# no longer consumed by the compose stack — kept here for reference.
SEARCH_DOMAIN=search.example.com

# Browser origins allowed to call the public search endpoints.
# Comma-separated, no protocol, regex-alternation friendly (the Caddyfile
# joins them into a regex).
ALLOWED_ORIGINS=space-map.example.com,preview.space-map.pages.dev

# Host directory for the Meili data volume.
MEILI_DATA_HOST_DIR=/srv/space-map/meili_data
