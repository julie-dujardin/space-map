# Host directory the tracking service publishes to, the one that holds `v1/`.
# Mounted read-only.
LIVE_HOST_DIR=/srv/space-map/space-map-live

# Cloudflare API token with the one permission Account > Workers Scripts > Edit.
CLOUDFLARE_API_TOKEN=changeme
# The account the token belongs to: the first path segment of a dashboard URL.
CLOUDFLARE_ACCOUNT_ID=changeme
