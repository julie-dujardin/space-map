# User and group the tracking service writes as.
PUID=1000
PGID=1000

# Pipeline config, read-only. The tracking service takes its User-Agent from it.
CONFIG_HOST_PATH=/srv/space-map/config.toml
# Holds the tracking stores, under `sources/activity/`.
DOWNLOADS_HOST_DIR=/srv/space-map/space-map-downloads
# The tree that gets deployed, the one that holds `v1/`.
LIVE_HOST_DIR=/srv/space-map/space-map-live
# The archive of every sample.
ACTIVITY_HOST_DIR=/srv/space-map/space-map-activity

# Cloudflare API token with the one permission Account > Workers Scripts > Edit.
CLOUDFLARE_API_TOKEN=changeme
# The account the token belongs to: the first path segment of a dashboard URL.
CLOUDFLARE_ACCOUNT_ID=changeme
