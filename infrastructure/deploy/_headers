/*
  Access-Control-Allow-Origin: https://spacemap.co

# Content-addressed classes: the frontend appends a per-class `?v=` token
# (metadata.json `versions`) so a content change yields a fresh URL. Safe to
# cache forever. Roots that stay revalidating (metadata.json, systems/,
# groups/, labels/, credits.json) carry no token and get no rule here — they
# fall through to Pages' default `max-age=0, must-revalidate`. Rules must not
# overlap: Pages comma-joins a header set by multiple matching rules, so a
# revalidating file must never also match an immutable glob.
/v1/position/*
  Cache-Control: public, max-age=31536000, immutable
/v1/objects/*
  Cache-Control: public, max-age=31536000, immutable
/v1/nomenclature/*
  Cache-Control: public, max-age=31536000, immutable
/v1/membership/*
  Cache-Control: public, max-age=31536000, immutable
/v1/textures/*
  Cache-Control: public, max-age=31536000, immutable
/v1/rings/*
  Cache-Control: public, max-age=31536000, immutable
/v1/models/*
  Cache-Control: public, max-age=31536000, immutable
/v1/images/*
  Cache-Control: public, max-age=31536000, immutable
