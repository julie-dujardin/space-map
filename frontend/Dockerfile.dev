ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-alpine

RUN corepack enable pnpm

WORKDIR /app

# The overrides and the patched dependency are declared in pnpm-workspace.yaml,
# and a frozen install refuses to run without them — patch file included.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ ./patches/
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 5173

CMD ["pnpm", "dev", "--host"]
