# Absolute origin of the data host (served by a separate Cloudflare Page).
# PUBLIC_DATA_URL=https://static.spacemap.co (default)

# Absolute origin of the image host (its own Workers static-assets project).
# Falls back to PUBLIC_DATA_URL when unset, so dev needs nothing here. Prod
# must set it — the data project no longer carries v1/images.
# PUBLIC_IMAGES_URL=https://images.spacemap.co

# Dev:
PUBLIC_DATA_URL=/data
# Upstream for the Vite dev proxy (optional, ignored in prod).
# DATA_SERVER_URL=http://localhost:8080

# Meilisearch endpoint + scoped search-only key. Generate the key with `uv run space-map-search search-key`.
# dev:
PUBLIC_MEILI_URL=http://127.0.0.1:7700
PUBLIC_MEILI_SEARCH_KEY=dev-master-key
# Empty values disable the search UI.
PUBLIC_MEILI_URL=
PUBLIC_MEILI_SEARCH_KEY=
