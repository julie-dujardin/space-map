# Absolute origin of the data host (served by a separate Cloudflare Page).
# Leave unset in local dev — the Vite proxy forwards `/data/*` to
# DATA_SERVER_URL (defaults to http://localhost:8080).
# PUBLIC_DATA_URL=https://data.example.com

# Upstream for the Vite dev proxy (dev only, ignored in prod).
# DATA_SERVER_URL=http://localhost:8080
